# Frontend configuration. Copy to frontend/.env.local - never commit real keys.
# Vite only exposes variables prefixed with VITE_.

# Leave empty to use the Vite dev proxy (frontend/vite.config.ts -> http://127.0.0.1:8000).
VITE_API_URL=

# API key of the demo user created by `python -m app.seed` (backend/.env).
VITE_API_KEY=
